enum JournalStatus {
  DRAFT
  POSTED
  CANCELLED
}

model Template {
  id          Int              @id @default(autoincrement())
  name        TemplateType     @unique
  description String?
  content     String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

enum TemplateType {
  MUDARABAH
  PROMISSORY_NOTE
  DEBT_ACKNOWLEDGMENT
  WITHDRAWAL_RECEIPT
  PAYMENT_VOUCHER
  SETTLEMENT
  PAYMENT_PROOF
  REPAYMENT_DUE
  REPAYMENT_LATE
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  GENERAL_NOTIFICATION
  EXPENSE_VOUCHER
  PARTNER_WITHDRAW_VOUCHER
}

model Settings {
  id        Int     @id @default(autoincrement())
  autoPost  Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ExternalInvestment {
  id          Int      @id @default(autoincrement())
  userId      Int
  amount      Float  
  returnedAmount Float? 
  profit      Float? 
  status      ExternalInvestmentStatus @default(OPEN)
  isDistributed Boolean @default(false)
  bankAccountId Int?
  createdAt   DateTime @default(now())
  returnedAt  DateTime?
  partnerShares ExternalInvestmentPartnerShare[]

  user        User @relation(fields: [userId], references: [id])
  bankAccount BANK_accounts? @relation(fields: [bankAccountId], references: [id])
}

enum ExternalInvestmentStatus {
  OPEN
  CLOSED
}

model ExternalInvestmentPartnerShare {
  id                   Int                @id @default(autoincrement())
  externalInvestmentId Int
  partnerId            Int
  sharePercent         Float
  orgProfitPercent     Float              @default(0)

  externalInvestment   ExternalInvestment @relation(fields: [externalInvestmentId], references: [id])
  partner              Partner            @relation(fields: [partnerId], references: [id])

  @@unique([externalInvestmentId, partnerId])
}