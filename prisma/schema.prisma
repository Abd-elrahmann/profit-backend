generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
    url       = env("DATABASE_URL")
  directUrl =  env("DIRECT_URL")
}

// USERS, ROLES, & PERMISSIONS
model User {
  id             Int                  @id @default(autoincrement())
  name           String
  email          String               @unique
  password       String
  phone          String               @unique
  profileImage   String?              // Add this line
  isActive       Boolean              @default(false)
  roleId         Int?
  role           Role?                @relation(fields: [roleId], references: [id])
  auditLogs      AuditLog[]
  postedJournals JournalHeader[]
  ResetToken     ResetPasswordToken[]
  ExpenseRecord  ExpenseRecord[]      @relation("UserExpenses")
  EmployeeExpenses ExpenseRecord[]    @relation("EmployeeExpenses")
  zakatWithdraw    zakatWithdraw[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  expenseAccountId  Int?               @unique
  expenseAccount  Account? @relation(name: "account_expenses", references: [id], fields: [expenseAccountId])
}

model ExpenseRecord {
  id          Int       @id @default(autoincrement())
  userId      Int       // الشخص الذي أضاف المصروف
  type        String    // نوع المصروف، مثال: "مصروف رواتب" أو "مصروف عام"
  amount      Float
  description String?
  employeeId  Int?     
  journalId   Int?      
  createdAt   DateTime  @default(now())

  user        User?     @relation("UserExpenses", fields: [userId], references: [id])
  employee    User?     @relation("EmployeeExpenses", fields: [employeeId], references: [id])
  journal     JournalHeader? @relation(fields: [journalId], references: [id])
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RolePermission {
  id        Int      @id @default(autoincrement())
  roleId    Int
  module    String
  canView   Boolean  @default(false)
  canAdd    Boolean  @default(false)
  canUpdate Boolean  @default(false)
  canDelete Boolean  @default(false)
  canPost   Boolean  @default(false)
  canExport Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  role Role @relation(fields: [roleId], references: [id])
}

model AuditLog {
  id          Int      @id @default(autoincrement())
  userId      Int
  screen      String
  action      String
  description String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model ResetPasswordToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
}

// CLIENTS, PARTNERS, LOANS, REPAYMENTS
model Client {
  id             Int              @id @default(autoincrement())
  name           String
  email          String?
  phone          String
  telegramChatId String?
  birthDate      DateTime
  address        String
  nationalId     String
  city           String
  district       String
  employer       String
  salary         Float
  obligations    Float
  creationReason String
  debit          Float            @default(0)
  credit         Float            @default(0)
  balance        Float            @default(0)
  status         ClientStatus     @default(نشط)
  documents      ClientDocument[]
  repayment      Repayment[]
  loans          Loan[]
  toLoan         Loan[]  @relation("convert")
  kafeelS         Kafeel[]
  notes          String?
  createdAt      DateTime         @default(now())
  JournalLine    JournalLine[]
  clientsClosing clientsClosing[]
  Notification   Notification[]
}

model Kafeel {
  id          Int      @id @default(autoincrement())
  clientId    Int
  name        String
  nationalId  String
  birthDate   DateTime
  city        String
  district    String
  employer    String
  salary      Float
  obligations Float
  phone       String
  email       String?
  kafeelIdImage  String?
  kafeelWorkCard String?
  client Client @relation(fields: [clientId], references: [id])
  loans           Loan[]
  createdAt   DateTime @default(now())
}

model ClientDocument {
  id             Int      @id @default(autoincrement())
  clientId       Int
  clientIdImage  String
  clientWorkCard String?
  salaryReport   String?
  simaReport     String?
  createdAt      DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])
}

enum ClientStatus {
  نشط
  منتهي
  متعثر
}

model Loan {
  id             Int         @id @default(autoincrement())
  code           String
  clientId       Int
  kafeelId       Int?
  amount         Float
  interestRate   Float
  interestAmount Float
  totalAmount    Float
  paymentAmount  Float
  generalAmount Float?
  newCapitalAmount Float?
  generalInterestAmount Float? 
  newCapitalInterestAmount Float?
  durationMonths Int
  type           LoanType
  source         LoanFundSource
  status         LoanStatus  @default(PENDING)
  startDate      DateTime
  endDate        DateTime?
  repaymentDay   DateTime?
  repayments     Repayment[]
  Notification   Notification[]
  createdAt      DateTime    @default(now())
  promissionaryDate      DateTime    @default(now())
  fromClientId     Int?
  fromclient     Client?      @relation("convert", fields: [fromClientId], references: [id])
  client         Client      @relation(fields: [clientId], references: [id])
  kafeel         Kafeel?     @relation(fields: [kafeelId], references: [id])
  bankAccountId  Int?
  bankAccount    BANK_accounts? @relation(fields: [bankAccountId], references: [id])
  partnerId      Int?
  partner   Partner? @relation(fields: [partnerId], references: [id])
  disbursementJournalId Int?   
  settlementJournalId   Int? 
  DEBT_ACKNOWLEDGMENT String?
  PROMISSORY_NOTE     String?
  SETTLEMENT          String?
  PAYMENT_PROOF       String[]
  debtAcknowledgmentNumber String?
  promissoryNoteNumber     String?
  issuanceCity            String?  
  paymentCity             String? 
  earlyPaidAmount       Float?      @default(0)
  earlyPaymentDiscount  Float?      @default(0)
  newAmount             Int?        @default(0)
  profitAccruals PartnerShareAccrual[]
  LoanPartnerShare LoanPartnerShare[]
  LoanNewCapitalShare LoanNewCapitalShare[]
  LoanCount  LoanCount[]
}

model LoanCount {
  id        Int      @id @default(autoincrement())
  loanId    Int
  count     Int      @default(0)
  loan    Loan    @relation(fields: [loanId], references: [id])
}

model RepaymentCount {
  id          Int        @id @default(autoincrement())
  repaymentId Int
  count       Int        @default(0)
  repayment   Repayment  @relation(fields: [repaymentId], references: [id])
}

model PartnerCount {
  id        Int      @id @default(autoincrement())
  partnerId Int
  count     Int      @default(0)
  partner   Partner  @relation(fields: [partnerId], references: [id])
}

model LoanPartnerShare {
  id        Int @id @default(autoincrement())
  loanId    Int
  partnerId Int
  sharePercent     Float
  orgProfitPercent Float     @default(0)
  isActive         Boolean   @default(true)

  loan    Loan    @relation(fields: [loanId], references: [id])
  partner Partner @relation(fields: [partnerId], references: [id])
  @@unique([loanId, partnerId])
}

enum LoanType {
  DAILY
  WEEKLY
  MONTHLY
}

enum LoanFundSource {
  GENERAL
  NEW_CAPITAL
  MIX
}

enum LoanStatus {
  PENDING
  ACTIVE
  COMPLETED
  DEFAULTED
}

model Repayment {
  id          Int           @id @default(autoincrement())
  count       Int
  loanId      Int
  clientId    Int
  dueDate     DateTime
  amount      Float
  remaining   Float
  paidAmount  Float         @default(0)
  principalAmount Float     @default(0)
  interestAmount Float      @default(0)
  status      PaymentStatus @default(PENDING)
  paymentDate DateTime?
  attachments  String[]
  PaymentProof String?
  reviewStatus String?
  notes        String?  
  discount     Float?
  postponeApproved  Boolean?   
  postponeReason    String?   
  newDueDate        DateTime?
  createdAt    DateTime      @default(now())
  loan         Loan          @relation(fields: [loanId], references: [id])
  client         Client      @relation(fields: [clientId], references: [id])
  Notification Notification[]
  profitAccruals PartnerShareAccrual[]
  RepaymentCount RepaymentCount[]
}

model SmallLoan {
  id          Int      @id @default(autoincrement())
  Name        String
  amount      Float
  paidAmount  Float    @default(0)
  remaining   Float
  status      SmallLoanStatus @default(OPEN)
  notes       String?
  createdAt   DateTime @default(now())
  closedAt    DateTime?
  @@index([status])
}

enum SmallLoanStatus {
  OPEN
  PARTIALLY_PAID
  PAID
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  type      NotificationType
  clientId  Int?
  loanId    Int?
  repaymentId Int?
  channel   String?
  sentAt    DateTime?
  scheduledAt  DateTime?
  createdAt DateTime @default(now())
  client   Client?   @relation(fields: [clientId], references: [id])
  loan     Loan?     @relation(fields: [loanId], references: [id])
  repayment Repayment? @relation(fields: [repaymentId], references: [id])
}

enum NotificationType {
  LOAN_REMINDER
  REPAYMENT_DUE
  REPAYMENT_LATE
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  GENERAL
}

enum PaymentStatus {
  PENDING
  PENDING_REVIEW
  PAID
  PARTIAL_PAID
  EARLY_PAID
  COMPLETED
  OVERDUE
}

model Partner {
  id               Int       @id @default(autoincrement())
  name             String
  nationalId       String
  address          String
  city             String?
  phone            String?
  email            String?
  orgProfitPercent Float
  capitalAmount    Float
  totalProfit      Float     @default(0)
  upcomingProfit   Float     @default(0)
  totalAmount      Float     @default(0)
  contractSignedAt DateTime?
  mudarabahFileUrl String?
  isActive         Boolean   @default(true)
  joinDistribute   Boolean   @default(true)
  WithdrawingStatus PartnerStatus @default(ACTIVE)
  isFrozen         Boolean @default(false)
  isNewPartner     Boolean @default(true)
  accountPayableId Int       @unique
  accountEquityId  Int       @unique
  accountSavingId  Int       @unique
  accountNewCapitalId Int @unique
  yearlyZakatRequired Float? @default(0)
  yearlyZakatPaid     Float? @default(0)
  yearlyZakatBalance  Float? @default(0)

  AccountPayable Account @relation(name: "account_payable", references: [id], fields: [accountPayableId])
  AccountEquity  Account @relation(name: "account_equity", references: [id], fields: [accountEquityId])
  AccountSaving  Account @relation(name: "account_saving", references: [id], fields: [accountSavingId])
  AccountNewCapital  Account @relation(name: "account_newCapital", references: [id], fields: [accountNewCapitalId])
  loans Loan[]
  transactions PartnerTransaction[]
  profitAccruals PartnerShareAccrual[]
  PartnerPeriodProfit  PartnerPeriodProfit[]
  LoanPartnerShare LoanPartnerShare[]
  ZakatAccrual ZakatAccrual[]
  ZakatPayment ZakatPayment[]
  PartnerSavingAccrual PartnerSavingAccrual[]
  PartnerWithdrawalSchedule PartnerWithdrawalSchedule[]
  PartnerWithdrawal PartnerWithdrawal[]
  PartnerNewCapital PartnerNewCapital[]
  LoanNewCapitalShare LoanNewCapitalShare[]
  PartnerCount PartnerCount[]

  createdAt DateTime @default(now())
}

enum PartnerStatus {
  ACTIVE
  WITHDRAWING
  WITHDRAWN
}

model PartnerNewCapital {
  id        Int      @id @default(autoincrement())
  partnerId Int      
  amount    Float
  remaining Float
  createdAt DateTime @default(now())

  Partner Partner @relation(fields: [partnerId], references: [id])
}

model LoanNewCapitalShare {
  id            Int     @id @default(autoincrement())
  loanId        Int
  partnerId     Int
  amountUsed    Float
  percent       Float
  orgProfitPercent Float  @default(0)
  partner Partner @relation(fields: [partnerId], references: [id])
  loan    Loan?   @relation(fields: [loanId], references: [id])
  @@unique([loanId, partnerId])
}

model PartnerWithdrawalSchedule {
  id Int @id @default(autoincrement())
  partnerId Int
  month Int
  year Int
  amount Float
  paidAmount Float   @default(0)
  remaining  Float   @default(0)
  status     String  @default("PENDING") 
  isPaid Boolean @default(false)
  carryAmount Float?
  carryFromId Int?
  createdAt DateTime @default(now())
  paidAt DateTime?

  partner Partner @relation(fields: [partnerId], references: [id])
}

model PartnerWithdrawal {
  id Int @id @default(autoincrement())
  partnerId Int
  monthlyAmount Float
  totalCapital Float
  defaultShare Float
  remainingCapital Float
  savingAmount Float
  WITHDRAWAL_RECEIPT String?
  createdAt DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id])
}

model PartnerTransaction {
  id             Int               @id @default(autoincrement())
  partnerId      Int
  type           TransactionType
  amount         Float
  date           DateTime          @default(now())
  reference      String?           @unique
  description    String?
  journalId      Int?
  createdAt      DateTime          @default(now())
  partner        Partner           @relation(fields: [partnerId], references: [id])
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PROFIT_WITHDRAWAL
  SAVING_WITHDRAWAL
}

model PartnerShareAccrual {
  id          Int       @id @default(autoincrement())
  partnerId   Int
  loanId      Int?
  repaymentId Int?
  rawShare       Float    
  companyCut     Float  
  partnerFinal   Float  
  cents          Float     @default(0) 
  isClosed       Boolean   @default(false)
  isDistributed  Boolean   @default(false)
  periodId      Int?
  createdAt   DateTime  @default(now())

  period  PeriodHeader? @relation(fields: [periodId], references: [id])
  partner     Partner   @relation(fields: [partnerId], references: [id])
  loan        Loan?     @relation(fields: [loanId], references: [id])
  repayment   Repayment? @relation(fields: [repaymentId], references: [id])
  @@unique([partnerId, loanId])
}

model ZakatAccrual {
  id         Int       @id @default(autoincrement())
  partnerId  Int
  partner    Partner   @relation(fields: [partnerId], references: [id])
  periodId   Int?
  year       Int
  month      Int
  amount     Float
  createdAt  DateTime  @default(now())

  @@unique([partnerId, year, month])
}

model ZakatPayment {
  id         Int       @id @default(autoincrement())
  partnerId  Int
  partner    Partner   @relation(fields: [partnerId], references: [id])
  periodId   Int?
  year       Int
  month      Int?
  amount     Float
  PAYMENT_VOUCHER String?
  createdAt  DateTime  @default(now())
}

model zakatWithdraw {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  amount     Int
  document   String?
  createdAt  DateTime  @default(now())
}

model PartnerSavingAccrual {
  id             Int      @id @default(autoincrement())
  partnerId      Int
  periodId       Int
  accrualId      Int
  savingAmount   Decimal
  createdAt      DateTime @default(now())

  partner        Partner  @relation(fields: [partnerId], references: [id])
  accrual        PartnerPeriodProfit   @relation("PartnerSavingAccrualToProfit", fields: [accrualId], references: [id])
}

model BANK_accounts {
  id             Int       @id @default(autoincrement())
  name           String
  owner          String
  accountNumber  String
  IBAN           String
  limit          Int
  status         AccountStatus @default(Active)
  loans          Loan[]
}

enum AccountStatus {
  Active
  Expired
}

// ACCOUNTING CORE
model Account {
  id               Int               @id @default(autoincrement())
  name             String
  code             String            @unique
  parentId         Int?
  type             AccountType
  level            Int               @default(1)
  isActive         Boolean           @default(true)
  credit           Float             @default(0)
  debit            Float             @default(0)
  balance          Float             @default(0)
  nature           AccountNature     @default(DEBIT)
  accountBasicType AccountBasicType
  parent           Account?          @relation("AccountHierarchy", fields: [parentId], references: [id])
  children         Account[]         @relation("AccountHierarchy")
  entries          JournalLine[]
  createdAt        DateTime          @default(now())
  partnerPayable   Partner?          @relation("account_payable")
  partnerEquity    Partner?          @relation("account_equity")
  partnerSaving    Partner?          @relation("account_saving")
  PartnerNewCapital   Partner?       @relation("account_newCapital")
  userExpenses     User?             @relation("account_expenses")
  accountsClosing  accountsClosing[]

  @@index([accountBasicType, code])
}

enum AccountBasicType {
  BANK
  CASH
  EXPENSES
  LOANS_RECEIVABLE
  SMALL_LOANS_RECEIVABLE
  PARTNER_PAYABLE
  PARTNER_EQUITY
  PARTNER_SAVING
  PARTNER_NEW_CAPITAL
  NEW_CAPITAL_BANK
  LOAN_INCOME
  COMPANY_SHARES
  PARTNER_SHARES_EXPENSES
  ZAKAT_EXPENSES
  SAVINGS
  LOSSES
  OTHER
}

enum AccountNature {
  DEBIT
  CREDIT
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model PeriodHeader {
  id               Int               @id @default(autoincrement())
  name             String
  startDate        DateTime
  endDate          DateTime?
  createdAt        DateTime          @default(now())
  openingJournalId Int?              @unique
  closingJournalId Int?              @unique
  isClosed         Boolean  @default(false)
  accountsClosing  accountsClosing[]
  clientsClosing   clientsClosing[]
  PartnerPeriodProfit  PartnerPeriodProfit[]
  PartnerShareAccrual  PartnerShareAccrual[]
  journals JournalHeader[]
}

model PartnerPeriodProfit {
  id        Int @id @default(autoincrement())
  partnerId Int
  periodId  Int
  totalProfit Float @default(0)

  partner Partner @relation(fields: [partnerId], references: [id])
  period  PeriodHeader @relation(fields: [periodId], references: [id])
  savings       PartnerSavingAccrual[] @relation("PartnerSavingAccrualToProfit")
}


model accountsClosing {
  id        Int @id @default(autoincrement())
  accountId Int
  periodId  Int

  openingDebit   Float    @default(0)
  openingCredit  Float    @default(0)
  openingBalance Float    @default(0)
  closingDebit   Float    @default(0)
  closingCredit  Float    @default(0)
  closingBalance Float    @default(0)
  lastUpdated    DateTime @default(now())

  account Account      @relation(fields: [accountId], references: [id])
  period  PeriodHeader @relation(fields: [periodId], references: [id])
}

model clientsClosing {
  id             Int      @id @default(autoincrement())
  clientId       Int
  periodId       Int
  openingDebit   Float    @default(0)
  openingCredit  Float    @default(0)
  openingBalance Float    @default(0)
  closingDebit   Float    @default(0)
  closingCredit  Float    @default(0)
  closingBalance Float    @default(0)
  lastUpdated    DateTime @default(now())

  period PeriodHeader @relation(fields: [periodId], references: [id])
  client Client       @relation(fields: [clientId], references: [id])
}

model JournalHeader {
  id          Int           @id @default(autoincrement())
  reference   String?       @unique
  description String?
  date        DateTime      @default(now())
  type        JournalType   @default(GENERAL)
  status      JournalStatus @default(DRAFT)
  sourceId    Int?
  sourceType  JournalSourceType?
  postedById  Int?
  postedBy    User?         @relation(fields: [postedById], references: [id])
  lines       JournalLine[]
  periodId    Int?
  createdAt   DateTime      @default(now())
  period      PeriodHeader? @relation(fields: [periodId], references: [id])
  ExpenseRecord ExpenseRecord[]
}

model JournalLine {
  id        Int   @id @default(autoincrement())
  journalId Int
  accountId Int
  debit     Float @default(0)
  credit    Float @default(0)
  balance   Float @default(0)
  clientId  Int?

  description String?
  client      Client?       @relation(fields: [clientId], references: [id])
  journal     JournalHeader @relation(fields: [journalId], references: [id])
  account     Account       @relation(fields: [accountId], references: [id])
}

enum JournalType {
  GENERAL
  OPENING
  CLOSING
  ADJUSTMENT
}

enum JournalSourceType {
  LOAN
  REPAYMENT
  PARTNER
  PARTNER_TRANSACTION_WITHDRAWAL
  PARTNER_TRANSACTION_DEPOSIT
  PARTNER_PROFIT_WITHDRAWAL
  PARTNER_SAVING_WITHDRAWAL
  PERIOD_CLOSING
  ZAKAT
  SAVING
  COMPANY_PROFIT_WITHDRAWAL
  EXPENSES
  LOSSES
  PARTNER_WITHDRAWING
  SMALL_LOAN
  LOAN_CONVERSION
  LOAN_INTEREST
  OTHER
}

enum JournalStatus {
  DRAFT
  POSTED
  CANCELLED
}

model Template {
  id          Int              @id @default(autoincrement())
  name        TemplateType     @unique
  description String?
  content     String
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

enum TemplateType {
  MUDARABAH
  PROMISSORY_NOTE
  DEBT_ACKNOWLEDGMENT
  WITHDRAWAL_RECEIPT
  PAYMENT_VOUCHER
  SETTLEMENT
  PAYMENT_PROOF
  REPAYMENT_DUE
  REPAYMENT_LATE
  PAYMENT_APPROVED
  PAYMENT_REJECTED
  GENERAL_NOTIFICATION
}